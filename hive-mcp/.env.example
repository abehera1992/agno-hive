# hive-mcp runtime configuration
# Copy to .env and adjust as needed

# Absolute path to your project (default: /project from Docker volume mount)
PROJECT_ROOT=/project

# Network
MCP_HOST=0.0.0.0
MCP_PORT=9000

# Set to true to stage all file writes for human review via hive CLI diff selector
WRITE_REVIEW=true

# Set to true to enable web_search and web_fetch tools
# Uses the client machine's network — no ZGX involvement
# Agents can search DuckDuckGo, fetch URLs, and read GitHub repos/READMEs
WEB_SEARCH_ENABLED=false
