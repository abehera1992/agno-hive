# ── VSCode diff watcher ───────────────────────────────────────────────────────

_PROPOSED_SUFFIX = ".hive_proposed"
_VSCODE_CANDIDATES = [
    "code",                                           # in PATH
    r"C:\Program Files\Microsoft VS Code\bin\code.cmd",
    r"C:\Program Files (x86)\Microsoft VS Code\bin\code.cmd",
]

_vscode_exe: str | None = None  # cached on first use

def _find_vscode() -> str | None:
    global _vscode_exe
    if _vscode_exe is not None:
        return _vscode_exe or None
    _no_win = {"creationflags": 0x08000000} if sys.platform == "win32" else {}
    for candidate in _VSCODE_CANDIDATES:
        try:
            r = subprocess.run(
                [candidate, "--version"],
                capture_output=True, timeout=3,
                **_no_win,
            )
            if r.returncode == 0:
                _vscode_exe = candidate
                return candidate
        except Exception:
            continue
    _vscode_exe = ""  # mark as not found
    return None


def _find_vscode_cli_ipc() -> str | None:
    """Locate VS Code's CLI IPC socket.

    VS Code sets VSCODE_IPC_HOOK_CLI in terminals it spawns, but some
    configurations don't inject it.  As a fallback we enumerate named pipes
    (Windows) or /tmp sockets (Unix) to find the vscode-ipc-*-sock socket
    that VS Code always creates regardless of env-var injection.
    """
    ipc = os.environ.get("VSCODE_IPC_HOOK_CLI")
    if ipc:
        return ipc

    if sys.platform == "win32":
        try:
            pipes = os.listdir("\\\\.\\pipe\\")
            for pipe in pipes:
                if pipe.startswith("vscode-ipc-") and pipe.endswith("-sock"):
                    return f"\\\\.\\pipe\\{pipe}"
        except Exception:
            pass
    else:
        try:
            import glob as _glob
            sockets = _glob.glob("/tmp/vscode-ipc-*.sock")
            if sockets:
                return max(sockets, key=lambda p: os.path.getmtime(p))
        except Exception:
            pass

    return None


def _vscode_ipc_open(file_uris: list[str], diff_mode: bool = False) -> bool:
    """Send an open/diff command directly to the running VS Code instance via IPC.

    The VS Code CLI server reads plain JSON until EOF, then processes the command.
    Using IPC means zero new Code.exe process and zero extra window.
    Falls back silently to the code CLI if no socket is found.
    """
    ipc = _find_vscode_cli_ipc()
    if not ipc:
        return False
    try:
        payload = json.dumps({
            "type": "open",
            "fileURIs": file_uris,
            "folderURIs": [],
            "diffMode": diff_mode,
            "forceReuseWindow": True,
        }).encode("utf-8")

        if sys.platform == "win32":
            import ctypes
            import ctypes.wintypes as _wt
            h = ctypes.windll.kernel32.CreateFileW(
                ipc, 0xC0000000, 0, None, 3, 0, None
            )
            if ctypes.cast(h, ctypes.c_ssize_t).value == -1:
                return False
            try:
                n = _wt.DWORD(0)
                ok = ctypes.windll.kernel32.WriteFile(
                    h, payload, len(payload), ctypes.byref(n), None
                )
                ctypes.windll.kernel32.FlushFileBuffers(h)
            finally:
                ctypes.windll.kernel32.CloseHandle(h)
            return bool(ok) and n.value > 0
        else:
            import socket as _sock
            with _sock.socket(_sock.AF_UNIX, _sock.SOCK_STREAM) as s:
                s.connect(ipc)
                s.sendall(payload)
                s.shutdown(_sock.SHUT_WR)
                s.recv(4096)
            return True
    except Exception:
        return False


def _open_vscode_for_proposed(proposed: Path) -> bool:
    """Open VS Code diff in the current window via IPC — zero new process, zero extra window.

    Returns True if the IPC call succeeded (diff is open in VS Code).
    Returns False if no IPC socket is available; caller shows inline terminal diff instead.

    No fallback to the code CLI: spawning Code.exe causes a window flash that
    is worse UX than the inline terminal diff, so we skip it entirely.
    """
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    is_new   = not original.exists()

    if is_new:
        return _vscode_ipc_open([proposed.as_uri()])
    else:
        return _vscode_ipc_open([original.as_uri(), proposed.as_uri()], diff_mode=True)


def _confirm_locally(proposed: Path) -> bool:
    """Apply a .hive_proposed file directly on the local filesystem."""
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    try:
        original.parent.mkdir(parents=True, exist_ok=True)
        original.write_bytes(proposed.read_bytes())
        proposed.unlink()
        print(green(f"  applied: {original.name}"))
        return True
    except Exception as e:
        print(red(f"  confirm failed: {e}"))
        return False


def _reject_locally(proposed: Path) -> bool:
    """Delete a .hive_proposed file without applying it."""
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    try:
        proposed.unlink()
        print(yellow(f"  rejected: {original.name} — no changes applied"))
        return True
    except Exception as e:
        print(red(f"  reject failed: {e}"))
        return False


def _arrow_select(options: list[str], hints: list[str] | None = None) -> int:
    """Arrow-key selector. Returns chosen index, or -1 if cancelled (Esc/Ctrl-C).
    Falls back to numbered input when stdout is not a TTY."""
    n = len(options)
    hints = hints or [""] * n

    if not _COLOUR or not sys.stdout.isatty():
        for i, (opt, hint) in enumerate(zip(options, hints), 1):
            suffix = f"  {hint}" if hint else ""
            print(f"  {i}  {opt}{suffix}")
        try:
            raw = input("  Choice [1]: ").strip() or "1"
            idx = int(raw) - 1
            return idx if 0 <= idx < n else 0
        except Exception:
            return 0

    selected = 0

    def _draw():
        for i, (opt, hint) in enumerate(zip(options, hints)):
            sys.stdout.write("\033[2K\r")
            h = f"  {dim(hint)}" if hint else ""
            if i == selected:
                sys.stdout.write(f"  {cyan('❯')} {bold(opt)}{h}\n")
            else:
                sys.stdout.write(f"    {dim(opt)}{h}\n")
        sys.stdout.flush()

    def _redraw():
        sys.stdout.write(f"\033[{n}A")
        _draw()

    print()
    _draw()

    try:
        import msvcrt
        while True:
            ch = msvcrt.getch()
            if ch in (b'\r', b'\n'):
                _redraw()
                return selected
            elif ch in (b'\x1b', b'\x03'):   # Esc or Ctrl-C
                _redraw()
                return -1
            elif ch == b'\xe0':              # extended key prefix
                ch2 = msvcrt.getch()
                if ch2 == b'\x48':           # up arrow
                    selected = (selected - 1) % n
                elif ch2 == b'\x50':         # down arrow
                    selected = (selected + 1) % n
                _redraw()
    except ImportError:
        try:
            import tty, termios, select as _sel
            fd = sys.stdin.fileno()
            old = termios.tcgetattr(fd)
            try:
                tty.setraw(fd)
                while True:
                    ch = sys.stdin.buffer.read(1)
                    if ch in (b'\r', b'\n'):
                        termios.tcsetattr(fd, termios.TCSADRAIN, old)
                        _redraw()
                        return selected
                    elif ch == b'\x03':      # Ctrl-C
                        termios.tcsetattr(fd, termios.TCSADRAIN, old)
                        _redraw()
                        return -1
                    elif ch == b'\x1b':
                        ready, _, _ = _sel.select([sys.stdin], [], [], 0.05)
                        if ready:
                            seq = sys.stdin.buffer.read(2)
                            if seq == b'[A':
                                selected = (selected - 1) % n
                            elif seq == b'[B':
                                selected = (selected + 1) % n
                        else:
                            termios.tcsetattr(fd, termios.TCSADRAIN, old)
                            _redraw()
                            return -1        # standalone Esc
                        _redraw()
            except Exception:
                try:
                    termios.tcsetattr(fd, termios.TCSADRAIN, old)
                except Exception:
                    pass
                return 0
        except Exception:
            return 0


def _show_inline_diff(original: Path, proposed: Path) -> None:
    """Print a coloured unified diff between original and proposed."""
    try:
        a = original.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
        b = proposed.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
        chunks = list(difflib.unified_diff(a, b, n=3))
        if not chunks:
            print(dim("  (no differences)"))
            return
        for line in chunks[2:]:        # skip --- / +++ header
            s = line.rstrip("\n")
            if s.startswith("+"):
                print(green("  " + s))
            elif s.startswith("-"):
                print(red("  " + s))
            elif s.startswith("@@"):
                print(cyan("  " + s))
            else:
                print(dim("  " + s))
    except Exception as exc:
        print(dim(f"  (diff unavailable: {exc})"))


def _prompt_confirm_reject(proposed: Path) -> None:
    """Show diff and arrow-key selector for a review_pending file.

    If VS Code IPC is available: opens diff tab in existing window, no new window.
    Otherwise: shows the diff inline in the terminal (like Claude Code CLI does),
    so the user can review without a distracting VS Code window flash.
    """
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    is_new = not original.exists()
    try:
        rel = str(original.relative_to(Path.cwd())).replace("\\", "/")
    except ValueError:
        rel = original.name

    ipc_ok = _open_vscode_for_proposed(proposed)

    # When IPC isn't available, show the diff inline so the user can review
    # without having to deal with a new VS Code window popping up.
    if not ipc_ok and not is_new:
        sep = dim("  " + "─" * 54)
        print(f"\n{sep}")
        _show_inline_diff(original, proposed)
        print(sep)

    label = "new file" if is_new else "review pending"
    print(f"\n  {bold(label)}  {cyan(rel)}")
    if ipc_ok:
        print(dim("  diff open in VS Code ↑"))

    if is_new:
        opts  = ["create", "reject", "skip"]
        hints = ["write new file", "discard", "decide later"]
    else:
        opts  = ["confirm", "reject", "skip"]
        hints = ["apply this change", "discard", "decide later"]

    choice = _arrow_select(opts, hints)
    print()

    if choice == 0:
        _confirm_locally(proposed)
    elif choice == 1:
        _reject_locally(proposed)
    else:
        print(dim("  skipped — /confirm or /reject when ready"))
    print()


# ── ESC interrupt ─────────────────────────────────────────────────────────────

_cancel_event = threading.Event()

def _start_escape_watcher() -> bool:
    """Start a daemon thread that sets _cancel_event when ESC is pressed.
    Returns True on Windows (msvcrt available), False otherwise."""
    _cancel_event.clear()
    try:
        import msvcrt
        def _watch():
            while not _cancel_event.is_set():
                if msvcrt.kbhit():
                    if msvcrt.getch() == b'\x1b':
                        _cancel_event.set()
                        return
                time.sleep(0.05)
        threading.Thread(target=_watch, daemon=True).start()
        return True
    except ImportError:
        return False  # Unix — use Ctrl+C instead


def _run_in_thread(fn, *args, **kwargs):
    """Run fn(*args, **kwargs) in a thread; return (result, error).
    Polls _cancel_event — returns (None, 'interrupted') if ESC pressed."""
    result_box: list = [None]
    error_box:  list = [None]

    def _target():
        try:
            result_box[0] = fn(*args, **kwargs)
        except Exception as exc:
            error_box[0] = exc

    t = threading.Thread(target=_target, daemon=True)
    t.start()
    while t.is_alive():
        if _cancel_event.is_set():
            return None, "interrupted"
        time.sleep(0.1)
    _cancel_event.set()  # stop watcher
    return result_box[0], error_box[0]


# ── Helpers ───────────────────────────────────────────────────────────────────

def detect_project() -> str:
    if AGNO_PROJECT:
        return AGNO_PROJECT
    try:
        r = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True, text=True, timeout=3,
        )
        if r.returncode == 0:
            url = r.stdout.strip().rstrip("/")
            name = url.split("/")[-1].replace(".git", "")
            if name:
                return name
    except Exception:
        pass
    return Path.cwd().name


def load_last_session(project_id: str) -> str | None:
    """Return last session ID for this project from ~/.agno_last_session."""
    try:
        data = json.loads(_LAST_SESSION_FILE.read_text())
        if data.get("project_id") == project_id:
            return data.get("session_id")
    except Exception:
        pass
    return None


def save_last_session(session_id: str, project_id: str) -> None:
    """Write last session ID to ~/.agno_last_session."""
    try:
        _LAST_SESSION_FILE.write_text(
            json.dumps({"session_id": session_id, "project_id": project_id})
        )
    except Exception:
        pass


def detect_mcp_url() -> str | None:
    """Try to discover the primary (project) MCP URL via Tailscale IP."""
    try:
        r = subprocess.run(
            ["tailscale", "ip", "-4"],
            capture_output=True, text=True, timeout=3,
        )
        ip = r.stdout.strip()
        if ip:
            return f"http://{ip}:{AGNO_MCP_PORT}/mcp"
    except Exception:
        pass
    return None


def detect_system_mcp_url() -> str | None:
    """Try to discover the hive-mcp (system/action) URL via Tailscale IP.
    Uses AGNO_SYSTEM_MCP_PORT (default 9003) so it doesn't conflict with
    the project MCP on port 9000."""
    try:
        r = subprocess.run(
            ["tailscale", "ip", "-4"],
            capture_output=True, text=True, timeout=3,
        )
        ip = r.stdout.strip()
        if ip:
            return f"http://{ip}:{AGNO_SYSTEM_MCP_PORT}/mcp"
    except Exception:
        pass
    return None


def check_mcp_reachable(url: str) -> tuple[bool, float]:
    """TCP-probe hive-mcp. Returns (reachable, latency_ms)."""
    import socket, time
    from urllib.parse import urlparse
    parsed = urlparse(url)
    host = parsed.hostname or "localhost"
    port = parsed.port or 9000
    t0 = time.perf_counter()
    try:
        with socket.create_connection((host, port), timeout=3):
            return True, (time.perf_counter() - t0) * 1000
    except Exception:
        return False, 0.0

# ── HTTP helpers ──────────────────────────────────────────────────────────────

def call_api(endpoint: str, payload: dict, timeout: int = 300) -> dict:
    data = json.dumps(payload).encode()
    req = urllib.request.Request(
        f"{AGNO_HOST}{endpoint}",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def call_get(endpoint: str, params: dict | None = None, timeout: int = 30) -> dict:
    url = f"{AGNO_HOST}{endpoint}"
    if params:
        url += "?" + urlencode(params)
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        return json.loads(resp.read())


def call_delete(endpoint: str, timeout: int = 30) -> dict:
    req = urllib.request.Request(f"{AGNO_HOST}{endpoint}", method="DELETE")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def call_patch(endpoint: str, timeout: int = 30) -> dict:
    req = urllib.request.Request(f"{AGNO_HOST}{endpoint}", method="PATCH")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def health_check() -> bool:
    try:
        with urllib.request.urlopen(f"{AGNO_HOST}/health", timeout=5) as r:
            return json.loads(r.read()).get("status") == "ok"
    except Exception:
        return False

# ── Result display ────────────────────────────────────────────────────────────

def _format_expiry(expires_at: str | None, persist: bool) -> str:
    if persist:
        return "[persistent]"
    if not expires_at:
        return ""
    try:
        from datetime import datetime
        exp = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        return f"expires {exp.strftime('%Y-%m-%d')}"
    except Exception:
        return ""


def _print_result(data: dict, show_resume: bool = False) -> None:
    result   = data.get("result", "")
    agents   = ", ".join(data.get("agents_used", []))
    duration = data.get("duration_seconds", 0)
    pulled   = data.get("models_pulled", [])
    session  = data.get("session", {})

    session_id    = session.get("session_id", "")
    turn          = session.get("turn", 0)
    context_size  = session.get("context_size", 0)
    compacted     = session.get("compacted", False)
    persist       = session.get("persist", False)
    expires_at    = session.get("expires_at")
    total_tokens  = data.get("total_tokens", 0)
    input_tokens  = data.get("input_tokens", 0)
    output_tokens = data.get("output_tokens", 0)

    print()
    print(result)
    print()

    sid_short   = session_id[:8] if session_id else ""
    context_str = f"summary + {context_size} msgs" if compacted else f"{context_size} msgs in context"
    expiry_str  = _format_expiry(expires_at, persist)

    def _fmt_tokens(n: int) -> str:
        return f"{n/1000:.1f}k" if n >= 1000 else str(n)

    parts = [f"── {duration:.1f}s"]
    if sid_short:
        parts.append(f"session {sid_short}")
    if turn:
        parts.append(f"turn {turn}")
    if session_id:
        parts.append(context_str)
    if expiry_str:
        parts.append(expiry_str)
    if total_tokens:
        parts.append(f"{_fmt_tokens(total_tokens)} tokens ({_fmt_tokens(input_tokens)} in / {_fmt_tokens(output_tokens)} out)")
    if pulled:
        parts.append(f"pulled: {', '.join(pulled)}")

    print(dim("  ·  ".join(parts)))
    if show_resume and session_id:
        print(dim(f"  resume: hive --session {session_id}"))
    print()

# ── Streaming HTTP ────────────────────────────────────────────────────────────

def _stream_api(endpoint: str, payload: dict, timeout: int = 600):
    """POST to endpoint and yield parsed SSE data dicts as they arrive.

    Reads the chunked HTTP response line-by-line — no third-party dependencies,
    pure urllib. Each 'data: {...}' line is parsed and yielded as a dict.
    """
    data = json.dumps(payload).encode()
    req = urllib.request.Request(
        f"{AGNO_HOST}{endpoint}",
        data=data,
        headers={"Content-Type": "application/json", "Accept": "text/event-stream"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        for raw in resp:
            line = raw.decode("utf-8", errors="replace")
            if line.startswith("data: "):
                payload_str = line[6:].strip()
                if payload_str:
                    try:
                        yield json.loads(payload_str)
                    except json.JSONDecodeError:
                        pass


