_COLOUR = sys.stdout.isatty()

def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _COLOUR else text

bold   = lambda t: _c("1",    t)
dim    = lambda t: _c("2",    t)
cyan   = lambda t: _c("36",   t)
red    = lambda t: _c("31",   t)
green  = lambda t: _c("32",   t)
yellow = lambda t: _c("33",   t)

# ── VSCode diff watcher ───────────────────────────────────────────────────────

_PROPOSED_SUFFIX = ".hive_proposed"
_VSCODE_CANDIDATES = [
    "code",                                           # in PATH
    r"C:\Program Files\Microsoft VS Code\bin\code.cmd",
    r"C:\Program Files (x86)\Microsoft VS Code\bin\code.cmd",
]

_vscode_exe: str | None = None  # cached on first use

def _find_vscode() -> str | None:
    global _vscode_exe
    if _vscode_exe is not None:
        return _vscode_exe or None
    _no_win = {"creationflags": 0x08000000} if sys.platform == "win32" else {}
    for candidate in _VSCODE_CANDIDATES:
        try:
            r = subprocess.run(
                [candidate, "--version"],
                capture_output=True, timeout=3,
                **_no_win,
            )
            if r.returncode == 0:
                _vscode_exe = candidate
                return candidate
        except Exception:
            continue
    _vscode_exe = ""  # mark as not found
    return None


def _find_vscode_cli_ipc() -> str | None:
    """Locate VS Code's CLI IPC socket.

    VS Code sets VSCODE_IPC_HOOK_CLI in terminals it spawns, but some
    configurations don't inject it.  As a fallback we enumerate named pipes
    (Windows) or /tmp sockets (Unix) to find the vscode-ipc-*-sock socket
    that VS Code always creates regardless of env-var injection.
    """
    ipc = os.environ.get("VSCODE_IPC_HOOK_CLI")
    if ipc:
        return ipc

    if sys.platform == "win32":
        try:
            pipes = os.listdir("\\\\.\\pipe\\")
            for pipe in pipes:
                if pipe.startswith("vscode-ipc-") and pipe.endswith("-sock"):
                    return f"\\\\.\\pipe\\{pipe}"
        except Exception:
            pass
    else:
        try:
            import glob as _glob
            sockets = _glob.glob("/tmp/vscode-ipc-*.sock")
            if sockets:
                return max(sockets, key=lambda p: os.path.getmtime(p))
        except Exception:
            pass

    return None


def _vscode_ipc_open(file_uris: list[str], diff_mode: bool = False) -> bool:
    """Send an open/diff command directly to the running VS Code instance via IPC.

    The VS Code CLI server reads plain JSON until EOF, then processes the command.
    Using IPC means zero new Code.exe process and zero extra window.
    Falls back silently to the code CLI if no socket is found.
    """
    ipc = _find_vscode_cli_ipc()
    if not ipc:
        return False
    try:
        payload = json.dumps({
            "type": "open",
            "fileURIs": file_uris,
            "folderURIs": [],
            "diffMode": diff_mode,
            "forceReuseWindow": True,
        }).encode("utf-8")

        if sys.platform == "win32":
            import ctypes
            import ctypes.wintypes as _wt
            h = ctypes.windll.kernel32.CreateFileW(
                ipc, 0xC0000000, 0, None, 3, 0, None
            )
            if ctypes.cast(h, ctypes.c_ssize_t).value == -1:
                return False
            try:
                n = _wt.DWORD(0)
                ok = ctypes.windll.kernel32.WriteFile(
                    h, payload, len(payload), ctypes.byref(n), None
                )
                ctypes.windll.kernel32.FlushFileBuffers(h)
            finally:
                ctypes.windll.kernel32.CloseHandle(h)
            return bool(ok) and n.value > 0
        else:
            import socket as _sock
            with _sock.socket(_sock.AF_UNIX, _sock.SOCK_STREAM) as s:
                s.connect(ipc)
                s.sendall(payload)
                s.shutdown(_sock.SHUT_WR)
                s.recv(4096)
            return True
    except Exception:
        return False


def _open_vscode_for_proposed(proposed: Path) -> bool:
    """Open VS Code diff in the current window via IPC — zero new process, zero extra window.

    Returns True if the IPC call succeeded (diff is open in VS Code).
    Returns False if no IPC socket is available; caller shows inline terminal diff instead.

    No fallback to the code CLI: spawning Code.exe causes a window flash that
    is worse UX than the inline terminal diff, so we skip it entirely.
    """
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    is_new   = not original.exists()

    if is_new:
        return _vscode_ipc_open([proposed.as_uri()])
    else:
        return _vscode_ipc_open([original.as_uri(), proposed.as_uri()], diff_mode=True)


def _confirm_locally(proposed: Path) -> bool:
    """Apply a .hive_proposed file directly on the local filesystem."""
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    try:
        original.parent.mkdir(parents=True, exist_ok=True)
        original.write_bytes(proposed.read_bytes())
        proposed.unlink()
        print(green(f"  applied: {original.name}"))
        return True
    except Exception as e:
        print(red(f"  confirm failed: {e}"))
        return False


def _reject_locally(proposed: Path) -> bool:
    """Delete a .hive_proposed file without applying it."""
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    try:
        proposed.unlink()
        print(yellow(f"  rejected: {original.name} — no changes applied"))
        return True
    except Exception as e:
        print(red(f"  reject failed: {e}"))
        return False


def _arrow_select(options: list[str], hints: list[str] | None = None) -> int:
    """Arrow-key selector. Returns chosen index, or -1 if cancelled (Esc/Ctrl-C).
    Falls back to numbered input when stdout is not a TTY."""
    n = len(options)
    hints = hints or [""] * n

    if not _COLOUR or not sys.stdout.isatty():
        for i, (opt, hint) in enumerate(zip(options, hints), 1):
            suffix = f"  {hint}" if hint else ""
            print(f"  {i}  {opt}{suffix}")
        try:
            raw = input("  Choice [1]: ").strip() or "1"
            idx = int(raw) - 1
            return idx if 0 <= idx < n else 0
        except Exception:
            return 0

    selected = 0

    def _draw():
        for i, (opt, hint) in enumerate(zip(options, hints)):
            sys.stdout.write("\033[2K\r")
            h = f"  {dim(hint)}" if hint else ""
            if i == selected:
                sys.stdout.write(f"  {cyan('❯')} {bold(opt)}{h}\n")
            else:
                sys.stdout.write(f"    {dim(opt)}{h}\n")
        sys.stdout.flush()

    def _redraw():
        sys.stdout.write(f"\033[{n}A")
        _draw()

    print()
    _draw()

    try:
        import msvcrt
        while True:
            ch = msvcrt.getch()
            if ch in (b'\r', b'\n'):
                _redraw()
                return selected
            elif ch in (b'\x1b', b'\x03'):   # Esc or Ctrl-C
                _redraw()
                return -1
            elif ch == b'\xe0':              # extended key prefix
                ch2 = msvcrt.getch()
                if ch2 == b'\x48':           # up arrow
                    selected = (selected - 1) % n
                elif ch2 == b'\x50':         # down arrow
                    selected = (selected + 1) % n
                _redraw()
    except ImportError:
        try:
            import tty, termios, select as _sel
            fd = sys.stdin.fileno()
            old = termios.tcgetattr(fd)
            try:
                tty.setraw(fd)
                while True:
                    ch = sys.stdin.buffer.read(1)
                    if ch in (b'\r', b'\n'):
                        termios.tcsetattr(fd, termios.TCSADRAIN, old)
                        _redraw()
                        return selected
                    elif ch == b'\x03':      # Ctrl-C
                        termios.tcsetattr(fd, termios.TCSADRAIN, old)
                        _redraw()
                        return -1
                    elif ch == b'\x1b':
                        ready, _, _ = _sel.select([sys.stdin], [], [], 0.05)
                        if ready:
                            seq = sys.stdin.buffer.read(2)
                            if seq == b'[A':
                                selected = (selected - 1) % n
                            elif seq == b'[B':
                                selected = (selected + 1) % n
                        else:
                            termios.tcsetattr(fd, termios.TCSADRAIN, old)
                            _redraw()
                            return -1        # standalone Esc
                        _redraw()
            except Exception:
                try:
                    termios.tcsetattr(fd, termios.TCSADRAIN, old)
                except Exception:
                    pass
                return 0
        except Exception:
            return 0


def _show_inline_diff(original: Path, proposed: Path) -> None:
    """Print a coloured unified diff between original and proposed."""
    try:
        a = original.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
        b = proposed.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
        chunks = list(difflib.unified_diff(a, b, n=3))
        if not chunks:
            print(dim("  (no differences)"))
            return
        for line in chunks[2:]:        # skip --- / +++ header
            s = line.rstrip("\n")
            if s.startswith("+"):
                print(green("  " + s))
            elif s.startswith("-"):
                print(red("  " + s))
            elif s.startswith("@@"):
                print(cyan("  " + s))
            else:
                print(dim("  " + s))
    except Exception as exc:
        print(dim(f"  (diff unavailable: {exc})"))


def _prompt_confirm_reject(proposed: Path) -> None:
    """Show diff and arrow-key selector for a review_pending file.

    If VS Code IPC is available: opens diff tab in existing window, no new window.
    Otherwise: shows the diff inline in the terminal (like Claude Code CLI does),
    so the user can review without a distracting VS Code window flash.
    """
    original = proposed.with_name(proposed.name[: -len(_PROPOSED_SUFFIX)])
    is_new = not original.exists()
    try:
        rel = str(original.relative_to(Path.cwd())).replace("\\", "/")
    except ValueError:
        rel = original.name

    ipc_ok = _open_vscode_for_proposed(proposed)

    # When IPC isn't available, show the diff inline so the user can review
    # without having to deal with a new VS Code window popping up.
    if not ipc_ok and not is_new:
        sep = dim("  " + "─" * 54)
        print(f"\n{sep}")
        _show_inline_diff(original, proposed)
        print(sep)

    label = "new file" if is_new else "review pending"
    print(f"\n  {bold(label)}  {cyan(rel)}")
    if ipc_ok:
        print(dim("  diff open in VS Code ↑"))

    if is_new:
        opts  = ["create", "reject", "skip"]
        hints = ["write new file", "discard", "decide later"]
    else:
        opts  = ["confirm", "reject", "skip"]
        hints = ["apply this change", "discard", "decide later"]

    choice = _arrow_select(opts, hints)
    print()

    if choice == 0:
        _confirm_locally(proposed)
    elif choice == 1:
        _reject_locally(proposed)
    else:
        print(dim("  skipped — /confirm or /reject when ready"))
    print()


# ── ESC interrupt ─────────────────────────────────────────────────────────────

_cancel_event = threading.Event()

def _start_escape_watcher() -> bool:
    """Start a daemon thread that sets _cancel_event when ESC is pressed.
    Returns True on Windows (msvcrt available), False otherwise."""
    _cancel_event.clear()
    try:
        import msvcrt
        def _watch():
            while not _cancel_event.is_set():
                if msvcrt.kbhit():
                    if msvcrt.getch() == b'\x1b':
                        _cancel_event.set()
                        return
                time.sleep(0.05)
        threading.Thread(target=_watch, daemon=True).start()
        return True
    except ImportError:
        return False  # Unix — use Ctrl+C instead


def _run_in_thread(fn, *args, **kwargs):
    """Run fn(*args, **kwargs) in a thread; return (result, error).
    Polls _cancel_event — returns (None, 'interrupted') if ESC pressed."""
    result_box: list = [None]
    error_box:  list = [None]

    def _target():
        try:
            result_box[0] = fn(*args, **kwargs)
        except Exception as exc:
            error_box[0] = exc

    t = threading.Thread(target=_target, daemon=True)
    t.start()
    while t.is_alive():
        if _cancel_event.is_set():
            return None, "interrupted"
        time.sleep(0.1)
    _cancel_event.set()  # stop watcher
    return result_box[0], error_box[0]


# ── Helpers ───────────────────────────────────────────────────────────────────

def detect_project() -> str:
    if AGNO_PROJECT:
        return AGNO_PROJECT
    try:
        r = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True, text=True, timeout=3,
        )
        if r.returncode == 0:
            url = r.stdout.strip().rstrip("/")
            name = url.split("/")[-1].replace(".git", "")
            if name:
                return name
    except Exception:
        pass
    return Path.cwd().name


def load_last_session(project_id: str) -> str | None:
    """Return last session ID for this project from ~/.agno_last_session."""
    try:
        data = json.loads(_LAST_SESSION_FILE.read_text())
        if data.get("project_id") == project_id:
            return data.get("session_id")
    except Exception:
        pass
    return None


def save_last_session(session_id: str, project_id: str) -> None:
    """Write last session ID to ~/.agno_last_session."""
    try:
        _LAST_SESSION_FILE.write_text(
            json.dumps({"session_id": session_id, "project_id": project_id})
        )
    except Exception:
        pass


def detect_mcp_url() -> str | None:
    """Try to discover the hive-mcp URL via Tailscale IP auto-detection.
    Returns a URL string on success, None if Tailscale is not available."""
    try:
        r = subprocess.run(
            ["tailscale", "ip", "-4"],
            capture_output=True, text=True, timeout=3,
        )
        ip = r.stdout.strip()
        if ip:
            return f"http://{ip}:{AGNO_MCP_PORT}/mcp"
    except Exception:
        pass
    return None


def check_mcp_reachable(url: str) -> tuple[bool, float]:
    """TCP-probe hive-mcp. Returns (reachable, latency_ms)."""
    import socket, time
    from urllib.parse import urlparse
    parsed = urlparse(url)
    host = parsed.hostname or "localhost"
    port = parsed.port or 9000
    t0 = time.perf_counter()
    try:
        with socket.create_connection((host, port), timeout=3):
            return True, (time.perf_counter() - t0) * 1000
    except Exception:
        return False, 0.0

# ── HTTP helpers ──────────────────────────────────────────────────────────────

def call_api(endpoint: str, payload: dict, timeout: int = 300) -> dict:
    data = json.dumps(payload).encode()
    req = urllib.request.Request(
        f"{AGNO_HOST}{endpoint}",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def call_get(endpoint: str, params: dict | None = None, timeout: int = 30) -> dict:
    url = f"{AGNO_HOST}{endpoint}"
    if params:
        url += "?" + urlencode(params)
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        return json.loads(resp.read())


def call_delete(endpoint: str, timeout: int = 30) -> dict:
    req = urllib.request.Request(f"{AGNO_HOST}{endpoint}", method="DELETE")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def call_patch(endpoint: str, timeout: int = 30) -> dict:
    req = urllib.request.Request(f"{AGNO_HOST}{endpoint}", method="PATCH")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def health_check() -> bool:
    try:
        with urllib.request.urlopen(f"{AGNO_HOST}/health", timeout=5) as r:
            return json.loads(r.read()).get("status") == "ok"
    except Exception:
        return False

# ── Result display ────────────────────────────────────────────────────────────

def _format_expiry(expires_at: str | None, persist: bool) -> str:
    if persist:
        return "[persistent]"
    if not expires_at:
        return ""
    try:
        from datetime import datetime
        exp = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        return f"expires {exp.strftime('%Y-%m-%d')}"
    except Exception:
        return ""


def _print_result(data: dict, show_resume: bool = False) -> None:
    result   = data.get("result", "")
    agents   = ", ".join(data.get("agents_used", []))
    duration = data.get("duration_seconds", 0)
    pulled   = data.get("models_pulled", [])
    session  = data.get("session", {})

    session_id    = session.get("session_id", "")
    turn          = session.get("turn", 0)
    context_size  = session.get("context_size", 0)
    compacted     = session.get("compacted", False)
    persist       = session.get("persist", False)
    expires_at    = session.get("expires_at")
    total_tokens  = data.get("total_tokens", 0)
    input_tokens  = data.get("input_tokens", 0)
    output_tokens = data.get("output_tokens", 0)

    print()
    print(result)
    print()

    sid_short   = session_id[:8] if session_id else ""
    context_str = f"summary + {context_size} msgs" if compacted else f"{context_size} msgs in context"
    expiry_str  = _format_expiry(expires_at, persist)

    def _fmt_tokens(n: int) -> str:
        return f"{n/1000:.1f}k" if n >= 1000 else str(n)

    parts = [f"── {duration:.1f}s"]
    if sid_short:
        parts.append(f"session {sid_short}")
    if turn:
        parts.append(f"turn {turn}")
    if session_id:
        parts.append(context_str)
    if expiry_str:
        parts.append(expiry_str)
    if total_tokens:
        parts.append(f"{_fmt_tokens(total_tokens)} tokens ({_fmt_tokens(input_tokens)} in / {_fmt_tokens(output_tokens)} out)")
    if pulled:
        parts.append(f"pulled: {', '.join(pulled)}")

    print(dim("  ·  ".join(parts)))
    if show_resume and session_id:
        print(dim(f"  resume: hive --session {session_id}"))
    print()

# ── Task runners ──────────────────────────────────────────────────────────────

def run_task(
    task: str,
    project_id: str,
    session_id: str | None = None,
    persist: bool = False,
    show_resume: bool = False,
) -> str | None:
    """Run a task; return the session_id from the response, or None on error."""
    # Snapshot existing .hive_proposed files before the run
    before = set(Path.cwd().rglob(f"*{_PROPOSED_SUFFIX}"))

    has_esc = _start_escape_watcher()
    esc_hint = dim("  ESC to interrupt") if has_esc else dim("  Ctrl+C to interrupt")
    if _COLOUR:
        print(f"{dim('  thinking...')}  {esc_hint}", end="\r", flush=True)

    payload = {
        "task":       task,
        "project_id": project_id,
        "team":       AGNO_TEAM,
        "session_id": session_id,
        "persist":    persist,
    }
    if AGNO_MCP_URL:
        payload["mcp_url"] = AGNO_MCP_URL

    data, err = _run_in_thread(call_api, "/run", payload)

    if _COLOUR:
        print(" " * 50, end="\r")

    if err == "interrupted":
        print(yellow("  interrupted"))
        return None
    if isinstance(err, urllib.error.HTTPError):
        body = err.read().decode(errors="replace")
        try:
            msg = json.loads(body).get("detail", body)
        except Exception:
            msg = body
        print(red(f"  server error {err.code}: {msg}"))
        return None
    if isinstance(err, urllib.error.URLError):
        print(red(f"  connection error: {err.reason}"))
        print(dim(f"  is AGNOHive running at {AGNO_HOST}?"))
        return None
    if err:
        print(red(f"  error: {err}"))
        return None

    _print_result(data, show_resume=show_resume)

    # Open VS Code diff for any .hive_proposed files created during this run
    after = set(Path.cwd().rglob(f"*{_PROPOSED_SUFFIX}"))
    new_proposed = after - before
    for p in new_proposed:
        _prompt_confirm_reject(p)

    return data.get("session", {}).get("session_id")


def review_task(
    task: str,
    project_id: str,
    session_id: str | None = None,
    persist: bool = False,
) -> str | None:
    """HITL flow — plan -> approve -> execute. Returns session_id or None."""
    has_esc = _start_escape_watcher()
    esc_hint = dim("  ESC to interrupt") if has_esc else dim("  Ctrl+C to interrupt")
    print(f"\n{bold('Planning...')} {dim('(ContextRouter -> Researcher -> Planner)')}  {esc_hint}\n")

    plan_payload = {"task": task, "project_id": project_id}
    if AGNO_MCP_URL:
        plan_payload["mcp_url"] = AGNO_MCP_URL

    data, err = _run_in_thread(call_api, "/plan", plan_payload)

    if err == "interrupted":
        print(yellow("  interrupted"))
        return None
    if isinstance(err, urllib.error.HTTPError):
        body = err.read().decode(errors="replace")
        try:
            msg = json.loads(body).get("detail", body)
        except Exception:
            msg = body
        print(red(f"  plan failed {err.code}: {msg}"))
        return None
    if err:
        print(red(f"  plan error: {err}"))
        return None

    plan     = data.get("plan", "")
    duration = data.get("duration_seconds", 0)

    print(f"{bold('─' * 60)}")
    print(f"{bold('Proposed Plan')}")
    print(f"{bold('─' * 60)}\n")
    print(plan)
    print(f"\n{dim(f'── planned in {duration:.1f}s')}\n")
    print(f"{bold('─' * 60)}\n")

    try:
        answer = input(f"{bold('Proceed with this plan?')} {dim('[Y/n]')} ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(f"\n{yellow('  aborted.')}")
        return None

    if answer in ("n", "no"):
        print(f"{yellow('  plan rejected — nothing was executed.')}")
        return None

    print(f"\n{bold('Executing...')} {dim('(full engineering team)')}\n")
    return run_task(task, project_id, session_id=session_id, persist=persist)

# ── REPL slash commands ───────────────────────────────────────────────────────

def _find_pending_diffs() -> list[Path]:
    """Return all .hive_proposed files under cwd."""
    return list(Path.cwd().rglob(f"*{_PROPOSED_SUFFIX}"))


def _cmd_diff() -> None:
    """Open VSCode diffs for all pending .hive_proposed files."""
    pending = _find_pending_diffs()
    if not pending:
        print(dim("  no pending diffs"))
        return
    for p in pending:
        original = p.with_name(p.name[: -len(_PROPOSED_SUFFIX)])
        try:
            print(dim(f"  pending: {original.relative_to(Path.cwd())}"))
        except ValueError:
            print(dim(f"  pending: {original}"))
        _open_vscode_for_proposed(p)


def _cmd_cleanup() -> None:
    """Delete all stale .hive_proposed files under the current directory."""
    pending = _find_pending_diffs()
    if not pending:
        print(dim("  no stale proposed files"))
        return
    print(f"\n  {len(pending)} stale proposed file(s):")
    for p in pending:
        original = p.with_name(p.name[: -len(_PROPOSED_SUFFIX)])
        try:
            print(dim(f"    {original.relative_to(Path.cwd())}"))
        except ValueError:
            print(dim(f"    {original}"))
    print()
    try:
        ans = input(bold(f"  Delete all {len(pending)} proposed file(s)? [y/N] ")).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(f"\n{yellow('  aborted.')}")
        return
    if ans not in ("y", "yes"):
        print(yellow("  aborted."))
        return
    ok = failed = 0
    for p in pending:
        try:
            p.unlink()
            ok += 1
        except Exception:
            failed += 1
    msg = green(f"  cleaned up {ok} proposed file(s)")
    if failed:
        msg += red(f"  ({failed} failed)")
    print(msg)
    print()


def _resolve_proposed(arg: str, pending: list[Path]) -> Path | None:
    """Resolve a .hive_proposed Path from an optional path arg and a list of pending files."""
    if arg:
        rel = arg.replace("\\", "/")
        name = Path(rel).name
        matches = [p for p in pending
                   if str(p.with_name(p.name[:-len(_PROPOSED_SUFFIX)]).relative_to(Path.cwd())).replace("\\", "/") == rel
                   or p.with_name(p.name[:-len(_PROPOSED_SUFFIX)]).name == name]
        if matches:
            return matches[0]
        print(yellow(f"  no pending diff for {arg}"))
        return None
    if len(pending) == 1:
        return pending[0]
    if len(pending) > 1:
        print(yellow("  multiple pending diffs — specify path:"))
        for p in pending:
            print(dim(f"    {p.with_name(p.name[:-len(_PROPOSED_SUFFIX)]).relative_to(Path.cwd())}"))
        return None
    print(yellow("  no pending diff found"))
    return None


def _cmd_sessions(project_id: str) -> None:
    try:
        data = call_get("/sessions", {"project_id": project_id, "limit": "20"})
        sessions = data.get("sessions", [])
        if not sessions:
            print(dim("  no sessions found for this project"))
            return
        print()
        for s in sessions:
            sid_short     = s["id"][:8]
            title         = s["title"][:52]
            count         = s.get("message_count", 0)
            persist_badge = " [persistent]" if s["persist"] else ""
            expires_str   = (
                f"  expires {s['expires_at'][:10]}"
                if s.get("expires_at") and not s["persist"]
                else ""
            )
            print(
                f"  {cyan(sid_short)}  {title}"
                f"{dim(persist_badge)}"
                f"  {dim(f'{count} msgs{expires_str}')}"
            )
        print()
    except Exception as e:
        print(red(f"  error listing sessions: {e}"))


def _cmd_history(session_id: str | None) -> None:
    if not session_id:
        print(yellow("  no active session"))
        return
    try:
        data = call_get(f"/sessions/{session_id}")
        summary  = data.get("summary")
        messages = data.get("messages", [])
        if summary:
            print(f"\n{dim('── summary ──────────────────────────────────────')}")
            print(dim(summary))
        print(f"\n{dim('── messages ─────────────────────────────────────')}")
        for m in messages:
            role_str = bold(f"[{m['role']}]")
            print(f"{role_str} {m['content'][:300]}")
        print()
    except Exception as e:
        print(red(f"  error fetching history: {e}"))


def _cmd_persist_current(session_id: str | None) -> None:
    if not session_id:
        print(yellow("  no active session"))
        return
    try:
        call_patch(f"/sessions/{session_id}/persist")
        print(green(f"  session {session_id[:8]} marked as persistent — it will never auto-delete"))
    except Exception as e:
        print(red(f"  error: {e}"))


def _cmd_delete(args: str) -> None:
    sid = args.strip()
    if not sid:
        print(yellow("  usage: /delete <session-id>"))
        return
    try:
        call_delete(f"/sessions/{sid}")
        print(green(f"  session {sid[:8]} deleted"))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            print(yellow(f"  session {sid[:8]} not found"))
        else:
            print(red(f"  error {e.code}: {e.read().decode()}"))
    except Exception as e:
        print(red(f"  error: {e}"))


def _cmd_list_sessions_oneshot(project_id: str) -> None:
    """Tabular listing for --list-sessions flag."""
    try:
        data = call_get("/sessions", {"project_id": project_id, "limit": "100"})
        sessions = data.get("sessions", [])
        if not sessions:
            print("No sessions found.")
            return
        header = f"{'ID':<10}  {'Title':<52}  {'Msgs':>4}  Status"
        print(f"\n{header}")
        print("─" * len(header))
        for s in sessions:
            sid_short = s["id"][:8]
            title     = s["title"][:52]
            count     = s.get("message_count", 0)
            if s["persist"]:
                status = "persistent"
            elif s.get("expires_at"):
                status = f"expires {s['expires_at'][:10]}"
            else:
                status = "—"
            print(f"{sid_short:<10}  {title:<52}  {count:>4}  {status}")
        print(f"\n{len(sessions)} session(s)")
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)


def _cmd_delete_all_sessions(project_id: str) -> None:
    """Delete all sessions for this project (prompts for confirmation)."""
    try:
        data = call_get("/sessions", {"project_id": project_id, "limit": "100"})
        sessions = data.get("sessions", [])
        if not sessions:
            print("No sessions found.")
            return

        persistent = [s for s in sessions if s["persist"]]
        ephemeral  = [s for s in sessions if not s["persist"]]

        print(f"\n  {len(sessions)} session(s) found — {len(ephemeral)} ephemeral, {len(persistent)} persistent")
        if persistent:
            print(yellow(f"  note: {len(persistent)} persistent session(s) will also be deleted"))
        try:
            answer = input(bold(f"  Delete all {len(sessions)} sessions for project '{project_id}'? [y/N] ")).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{yellow('  aborted.')}")
            return
        if answer not in ("y", "yes"):
            print(yellow("  aborted — nothing deleted."))
            return

        deleted = 0
        failed  = 0
        for s in sessions:
            try:
                call_delete(f"/sessions/{s['id']}")
                deleted += 1
            except Exception:
                failed += 1

        print(green(f"  deleted {deleted} session(s)") + (red(f"  ({failed} failed)") if failed else ""))
        # Clear local last-session file if it pointed to this project
        try:
            local = json.loads(_LAST_SESSION_FILE.read_text())
            if local.get("project_id") == project_id:
                _LAST_SESSION_FILE.unlink()
        except Exception:
            pass
        print()
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

def _cmd_mcp_status() -> None:
    """Show hive-mcp connection status."""
    url = AGNO_MCP_URL
    if not url:
        print(f"\n  {bold('hive-mcp')}  {yellow('not configured')}")
        print(dim("  Auto-detection via Tailscale found nothing."))
        print(dim("  → install Tailscale, or set AGNO_MCP_URL explicitly"))
        print(dim("  → start hive-mcp: docker compose -f docker-compose.hive.yml up -d"))
        print()
        return

    reachable, ms = check_mcp_reachable(url)
    status = green(f"+  reachable  ({ms:.0f} ms)") if reachable else red("!  unreachable")
    src    = "env var" if os.getenv("AGNO_MCP_URL") else "Tailscale auto-detect"
    print(f"\n  {bold('hive-mcp')}")
    print(f"  url     {cyan(url)}")
    print(f"  source  {dim(src)}")
    print(f"  status  {status}")
    if not reachable:
        print(dim("  → docker compose -f docker-compose.hive.yml up -d"))
    print()


# ── Interactive REPL ──────────────────────────────────────────────────────────

def repl(
    project_id: str,
    review: bool = False,
    initial_session_id: str | None = None,
    persist: bool = False,
) -> None:
    history_file = Path.home() / ".agno_history"
    if _READLINE:
        try:
            readline.read_history_file(history_file)
        except FileNotFoundError:
            pass
        readline.set_history_length(500)

    # Resolve starting session
    session_id: str | None = initial_session_id
    is_explicit = initial_session_id is not None
    if session_id is None:
        session_id = load_last_session(project_id)
        is_resumed = session_id is not None
    else:
        is_resumed = True

    # Banner
    mode_label = cyan("review") if review else cyan(AGNO_TEAM)
    print(
        f"\n{bold('AGNOHive')}  "
        f"project {cyan(project_id)}  "
        f"mode {mode_label}  "
        f"{dim(AGNO_HOST)}"
    )
    if not health_check():
        print(yellow("  warning: AGNOHive is not reachable — tasks will fail"))

    # MCP status line
    if AGNO_MCP_URL:
        reachable, ms = check_mcp_reachable(AGNO_MCP_URL)
        mcp_indicator = green(f"+ {ms:.0f}ms") if reachable else red("! unreachable")
        print(dim(f"  mcp  {AGNO_MCP_URL}  ") + mcp_indicator)
    else:
        print(dim("  mcp  ") + yellow("not configured") + dim("  — /mcp for setup help"))

    if session_id and is_resumed and not is_explicit:
        print(dim(f"  resuming session {session_id[:8]}  (last used this project)"))
    elif session_id and is_explicit:
        print(dim(f"  session {session_id[:8]}"))
    else:
        print(dim("  new session will be created on first prompt"))

    if review:
        print(dim("  review mode: plan shown before every task  ·  prefix with ! to skip"))

    print(dim("  /new  /sessions  /history  /persist  /delete <id>  /delete-all  /diff  /cleanup  /mcp  /exit  ·  ESC to interrupt\n"))

    try:
        while True:
            try:
                task = input(bold("> ")).strip()
            except EOFError:
                print()
                break

            if not task:
                continue

            # ── Slash commands ─────────────────────────────────────────────
            if task.startswith("/"):
                parts = task.split(None, 1)
                cmd   = parts[0].lower()
                args  = parts[1] if len(parts) > 1 else ""

                if cmd == "/exit":
                    break
                elif cmd == "/new":
                    session_id = None
                    print(dim("  started new session (will be created on next prompt)"))
                elif cmd == "/sessions":
                    _cmd_sessions(project_id)
                elif cmd == "/history":
                    _cmd_history(session_id)
                elif cmd == "/persist":
                    _cmd_persist_current(session_id)
                elif cmd == "/delete":
                    _cmd_delete(args)
                elif cmd == "/diff":
                    _cmd_diff()
                elif cmd == "/cleanup":
                    _cmd_cleanup()
                elif cmd == "/mcp":
                    _cmd_mcp_status()
                elif cmd == "/delete-all":
                    _cmd_delete_all_sessions(project_id)
                elif cmd in ("/confirm", "/reject"):
                    pending = _find_pending_diffs()
                    if args.strip():
                        rel = args.strip().replace("\\", "/")
                        candidates = [p for p in pending
                                      if p.with_name(p.name[:-len(_PROPOSED_SUFFIX)]).name == Path(rel).name
                                      or str(p.with_name(p.name[:-len(_PROPOSED_SUFFIX)]).relative_to(Path.cwd())).replace("\\", "/") == rel]
                        proposed = candidates[0] if candidates else None
                        if not proposed:
                            print(yellow(f"  no pending diff for {rel}"))
                    elif len(pending) == 1:
                        proposed = pending[0]
                    elif len(pending) > 1:
                        print(yellow("  multiple pending diffs — specify path:"))
                        for p in pending:
                            print(dim(f"    {p.with_name(p.name[:-len(_PROPOSED_SUFFIX)]).relative_to(Path.cwd())}"))
                        proposed = None
                    else:
                        print(yellow("  no pending diff found"))
                        proposed = None
                    if proposed:
                        _confirm_locally(proposed) if cmd == "/confirm" else _reject_locally(proposed)
                else:
                    print(dim(f"  unknown command: {cmd}  ·  /new /sessions /history /persist /delete /diff /cleanup /mcp /confirm /reject /exit"))
                continue

            # ── Bare confirm / reject (no slash) ───────────────────────────
            lower = task.lower()
            if lower == "confirm" or lower.startswith("confirm "):
                arg = task[7:].strip()
                pending = _find_pending_diffs()
                proposed = _resolve_proposed(arg, pending)
                if proposed:
                    _confirm_locally(proposed)
                continue
            if lower == "reject" or lower.startswith("reject "):
                arg = task[6:].strip()
                pending = _find_pending_diffs()
                proposed = _resolve_proposed(arg, pending)
                if proposed:
                    _reject_locally(proposed)
                continue

            # ── Run task ───────────────────────────────────────────────────
            skip_review = task.startswith("!") and review
            clean_task  = task[1:].strip() if skip_review else task

            if skip_review or not review:
                returned_id = run_task(
                    clean_task, project_id,
                    session_id=session_id, persist=persist,
                )
            else:
                returned_id = review_task(
                    clean_task, project_id,
                    session_id=session_id, persist=persist,
                )

            if returned_id:
                session_id = returned_id

    except KeyboardInterrupt:
        print()
    finally:
        if _READLINE:
            readline.write_history_file(history_file)
        if session_id:
            save_last_session(session_id, project_id)
            print(f"\n{dim('  session saved:  ' + session_id)}")
            print(dim(f"  resume later:   hive --session {session_id}"))

# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(
        prog="hive",
        description="AGNOHive CLI — run the agent swarm from your terminal",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    global AGNO_HOST, AGNO_TEAM, AGNO_MCP_URL

    parser.add_argument("task",                 nargs="*", help="task to run (omit for REPL)")
    parser.add_argument("--project",  "-p",               help="project id (default: auto-detect)")
    parser.add_argument("--team",     "-t",               help=f"team (default: {AGNO_TEAM})")
    parser.add_argument("--host",     "-H",               help=f"AGNOHive host (default: {AGNO_HOST})")
    parser.add_argument("--review",   "-r",  action="store_true",
                        help="show plan and ask for approval before executing")
    parser.add_argument("--session",  "-s",               help="resume a specific session by ID")
    parser.add_argument("--persist",          action="store_true",
                        help="mark session as permanent (never auto-deleted)")
    parser.add_argument("--list-sessions",    action="store_true",
                        help="list recent sessions for this project and exit")
    parser.add_argument("--delete-all-sessions", action="store_true",
                        help="delete all sessions for this project (prompts for confirmation)")
    parser.add_argument("--mcp-url",           metavar="URL",
                        help="hive-mcp URL (overrides AGNO_MCP_URL and auto-detection)")
    parser.add_argument("--mcp-port",          metavar="PORT", default=None,
                        help=f"hive-mcp port for Tailscale auto-detection (default: {AGNO_MCP_PORT})")
    parser.add_argument("--mcp-status",        action="store_true",
                        help="show hive-mcp connection status and exit")

    args = parser.parse_args()

    if args.host:
        AGNO_HOST = args.host
    if args.team:
        AGNO_TEAM = args.team

    # Resolve MCP URL: flag > env var > Tailscale auto-detect
    if args.mcp_url:
        AGNO_MCP_URL = args.mcp_url
    elif not AGNO_MCP_URL:
        if args.mcp_port:
            # Use custom port for auto-detection
            import importlib, sys as _sys
            _mod = _sys.modules[__name__]
            _mod.AGNO_MCP_PORT = args.mcp_port
        detected = detect_mcp_url()
        if detected:
            AGNO_MCP_URL = detected

    project_id = args.project or detect_project()

    if args.mcp_status:
        _cmd_mcp_status()
        return

    if args.list_sessions:
        _cmd_list_sessions_oneshot(project_id)
        return

    if args.delete_all_sessions:
        _cmd_delete_all_sessions(project_id)
        return

    # Handle bare: hive confirm [path]  /  hive reject [path]
    if args.task and args.task[0].lower() in ("confirm", "reject"):
        verb = args.task[0].lower()
        arg_path = " ".join(args.task[1:])
        pending = _find_pending_diffs()
        proposed = _resolve_proposed(arg_path, pending)
        if proposed:
            _confirm_locally(proposed) if verb == "confirm" else _reject_locally(proposed)
        return

    if args.task:
        task = " ".join(args.task)
        if args.review:
            review_task(task, project_id, session_id=args.session, persist=args.persist)
        else:
            run_task(
                task, project_id,
                session_id=args.session, persist=args.persist,
                show_resume=True,
            )
    else:
        repl(
            project_id,
            review=args.review,
            initial_session_id=args.session,
            persist=args.persist,
        )


if __name__ == "__main__":
    main()
