def run_task(
    task: str,
    project_id: str,
    session_id: str | None = None,
    persist: bool = False,
    show_resume: bool = False,
) -> str | None:
    """Run a task via streaming SSE; return session_id or None on error."""
    before = set((Path(AGNO_PROJECT_ROOT) if AGNO_PROJECT_ROOT else Path.cwd()).rglob(f"*{_PROPOSED_SUFFIX}"))

    has_esc = _start_escape_watcher()
    esc_hint = dim("  ESC to interrupt") if has_esc else dim("  Ctrl+C to interrupt")

    payload = {
        "task":       task,
        "project_id": project_id,
        "team":       AGNO_TEAM,
        "session_id": session_id,
        "persist":    persist,
    }
    if AGNO_MCP_URL:
        payload["mcp_url"] = AGNO_MCP_URL
    if AGNO_SYSTEM_MCP_URL:
        payload["mcp_urls"] = [AGNO_SYSTEM_MCP_URL]

    if _COLOUR:
        print(f"{dim('  thinking...')}  {esc_hint}", end="\r", flush=True)

    done_data: dict = {}
    first_chunk = True
    returned_session_id: str | None = None

    try:
        for event in _stream_api("/stream", payload, timeout=600):
            if _cancel_event.is_set():
                print(f"\n{yellow('  interrupted')}")
                _cancel_event.clear()
                return None

            etype = event.get("type")

            if etype == "chunk":
                chunk = event.get("content", "")
                if chunk:
                    if first_chunk:
                        if _COLOUR:
                            print(" " * 54, end="\r")  # clear "thinking..." line
                        print()
                        first_chunk = False
                    print(chunk, end="", flush=True)

            elif etype == "done":
                done_data = event
                returned_session_id = event.get("session", {}).get("session_id")
                break

            elif etype == "error":
                print(f"\n{red('  error: ' + event.get('content', 'unknown'))}")
                return None

    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        try:
            msg = json.loads(body).get("detail", body)
        except Exception:
            msg = body
        print(red(f"\n  server error {e.code}: {msg}"))
        return None
    except urllib.error.URLError as e:
        print(red(f"\n  connection error: {e.reason}"))
        print(dim(f"  is AGNOHive running at {AGNO_HOST}?"))
        return None
    except Exception as e:
        print(red(f"\n  error: {e}"))
        return None

    _cancel_event.set()  # stop ESC watcher

    if not first_chunk:
        print("\n")   # newline after streamed content

    if done_data:
        _print_footer(done_data, show_resume=show_resume)

    after = set((Path(AGNO_PROJECT_ROOT) if AGNO_PROJECT_ROOT else Path.cwd()).rglob(f"*{_PROPOSED_SUFFIX}"))
    for p in after - before:
        _prompt_confirm_reject(p)

    return returned_session_id


def review_task(
    task: str,
    project_id: str,
    session_id: str | None = None,
    persist: bool = False,
) -> str | None:
    """HITL flow — plan -> approve -> execute. Returns session_id or None."""
    has_esc = _start_escape_watcher()
    esc_hint = dim("  ESC to interrupt") if has_esc else dim("  Ctrl+C to interrupt")
    print(f"\n{bold('Planning...')} {dim('(ContextRouter -> Researcher -> Planner)')}  {esc_hint}\n")

    plan_payload = {"task": task, "project_id": project_id}
    if AGNO_MCP_URL:
        plan_payload["mcp_url"] = AGNO_MCP_URL
    if AGNO_SYSTEM_MCP_URL:
        plan_payload["mcp_urls"] = [AGNO_SYSTEM_MCP_URL]

    data, err = _run_in_thread(call_api, "/plan", plan_payload, 600)

    if err == "interrupted":
        print(yellow("  interrupted"))
        return None
    if isinstance(err, urllib.error.HTTPError):
        body = err.read().decode(errors="replace")
        try:
            msg = json.loads(body).get("detail", body)
        except Exception:
            msg = body
        print(red(f"  plan failed {err.code}: {msg}"))
        return None
    if err:
        print(red(f"  plan error: {err}"))
        return None

    plan     = data.get("plan", "")
    duration = data.get("duration_seconds", 0)

    print(f"{bold('─' * 60)}")
    print(f"{bold('Proposed Plan')}")
    print(f"{bold('─' * 60)}\n")
    print(plan)
    print(f"\n{dim(f'── planned in {duration:.1f}s')}\n")
    print(f"{bold('─' * 60)}\n")

    try:
        answer = input(f"{bold('Proceed with this plan?')} {dim('[Y/n]')} ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(f"\n{yellow('  aborted.')}")
        return None

    if answer in ("n", "no"):
        print(f"{yellow('  plan rejected — nothing was executed.')}")
        return None

    print(f"\n{bold('Executing...')} {dim('(full engineering team)')}\n")
    return run_task(task, project_id, session_id=session_id, persist=persist)

