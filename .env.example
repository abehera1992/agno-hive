# Ollama inference server (ZGX Tailscale IP)
OLLAMA_HOST=http://100.96.86.82:11434

# Models — all support native tool_calls in Ollama (no OllamaToolFix needed)
# Note: if using qwen2.5 variants, OllamaToolFix is applied automatically via get_model()
LEADER_MODEL=llama3.3:70b
CODER_MODEL=mistral-small3.1:24b
REVIEWER_MODEL=gemma3:27b

# Memory footprint: llama3.3:70b ~43GB + mistral-small3.1:24b ~15GB + gemma3:27b ~17GB = ~75GB / 120GB ZGX

# MCP context server on dev PC — change per project
MCP_URL=http://100.87.159.86:9000/sse

# PostgreSQL for shared conscience (claude_flow schema)
DB_URL=postgresql://user:password@100.87.159.86:5432/ekamApp
MEMORY_NAMESPACE=agno-hive

# Swarm behaviour
STREAM=true
MAX_ITERATIONS=10
