# Ollama inference server (native on ZGX, not in Docker)
OLLAMA_HOST=http://<zgx-ip>:11434

# Models — coordinator + core agents
LEADER_MODEL=qwen3:30b-a3b
CODER_MODEL=mistral-small3.1:24b
REVIEWER_MODEL=gemma3:27b

# Models — expanded agent roster (Phase 2)
PLANNER_MODEL=deepseek-r1
RESEARCHER_MODEL=mixtral:8x7b
EXECUTOR_MODEL=llama3.1:8b
ROUTER_MODEL=llama3.1:8b

# MCP server of the project you want to work on
MCP_URL=http://<project-machine-ip>:9000/sse

# Pattern file discovery glob — relative to the project root on the MCP server
# Default is patterns/**/*.md — only set if your project uses a different layout
# PATTERNS_GLOB=patterns/**/*.md

# Storage — ZGX-local services (docker/docker-compose.zgx.yml)
QDRANT_URL=http://localhost:6333
POSTGRES_URI=postgresql://agno:agno@localhost:5432/agno_graph

# Observability — point at your existing SigNoz or any OTel-compatible backend
OTLP_ENDPOINT=http://<ekam-host>:4318

# Swarm behaviour
STREAM=false
MAX_ITERATIONS=5
