# Ollama inference server (native on ZGX, not in Docker)
OLLAMA_HOST=http://<zgx-ip>:11434

# Models — coordinator + core agents (current roster; teams/*.yaml is the source of truth)
LEADER_MODEL=qwen3-coder:30b
CODER_MODEL=qwen2.5-coder:32b
REVIEWER_MODEL=qwen2.5-coder:32b

# Models — expanded agent roster
PLANNER_MODEL=qwen2.5-coder:32b
RESEARCHER_MODEL=qwen2.5-coder:32b
EXECUTOR_MODEL=llama3.1:8b
ROUTER_MODEL=llama3.1:8b

# MCP server of the project you want to work on
MCP_URL=http://<project-machine-ip>:9000/sse

# Pattern file discovery glob — relative to the project root on the MCP server
# Default is patterns/**/*.md — only set if your project uses a different layout
# PATTERNS_GLOB=patterns/**/*.md

# Storage — ZGX-local services (docker/docker-compose.zgx.yml)
QDRANT_URL=http://localhost:6333
POSTGRES_URI=postgresql://agno:agno@localhost:5432/agno_graph

# LightRAG MCP server (Phase 3)
LIGHTRAG_MCP_PORT=9002
LIGHTRAG_MCP_URL=http://localhost:9002/sse
LIGHTRAG_LLM_MODEL=qwen2.5-coder:7b       # model used for entity/relation extraction
LIGHTRAG_EMBED_MODEL=qwen3-embedding:0.6b  # must be pulled in Ollama first
LIGHTRAG_EMBED_DIM=1024                    # must match the embed model's output dimension
# LIGHTRAG_WORKING_DIR=~/.agno-hive/lightrag  # default, override if needed

# Inference backend (Ollama->vLLM migration, EK-105). "ollama" (default) or "vllm".
# Both paths stay live; flip + restart LightRAG to switch. Revert = set back to ollama.
# vLLM serves the SAME 1024-dim embeddings (cosine 0.999 vs Ollama) so the index is reused.
INFERENCE_BACKEND=ollama
VLLM_LLM_BASE_URL=http://localhost:8001/v1
VLLM_LLM_MODEL=RedHatAI/Qwen2.5-Coder-7B-Instruct-FP8-dynamic
VLLM_EMBED_BASE_URL=http://localhost:8002/v1
VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Observability — standard OTel env vars (same convention as Ekam service stack)
# Point at the SigNoz otel-collector on the Ekam host (port 4317 must be exposed)
OTEL_EXPORTER_OTLP_ENDPOINT=http://<ekam-host-ip>:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=service.name=agno-hive,deployment.environment=dev
# OTEL_SDK_DISABLED=true   # uncomment to disable telemetry entirely
# OTEL_METRICS_EXPORTER=none  # uncomment to disable metrics only

# Swarm behaviour
STREAM=false
MAX_ITERATIONS=5

# Session persistence
SESSION_TTL_DAYS=30              # days before unpersisted sessions are deleted
AGNO_SESSION_WINDOW=6            # verbatim messages injected per request
AGNO_COMPACT_THRESHOLD=20        # total messages before compaction triggers
SESSION_CLEANUP_INTERVAL=3600    # seconds between TTL cleanup sweeps
